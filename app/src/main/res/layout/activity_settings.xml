<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <!-- صدا -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_s"
            android:text="@string/voice"
            android:textColor="@color/brand_accent"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.IranAmap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/rowVoiceSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_l">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/voice_settings"
                    android:src="@drawable/ic_volume"
                    app:tint="@color/brand_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_settings"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvCurrentVoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/voice_settings"
                    android:src="@drawable/ic_chevron"
                    app:tint="@color/text_secondary_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- اعلام‌ها -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_s"
            android:text="@string/announcements"
            android:textColor="@color/brand_accent"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.IranAmap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_m">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swStreetNames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/announce_street_names"
                    android:textColor="@color/text_primary_dark" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swLights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/announce_lights"
                    android:textColor="@color/text_primary_dark" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swSpeedWarn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/announce_speed"
                    android:textColor="@color/text_primary_dark" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swArrival"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/announce_arrival"
                    android:textColor="@color/text_primary_dark" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swTraffic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/announce_traffic"
                    android:textColor="@color/text_primary_dark" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/verbosity"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgVerbosity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbLow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/verbosity_low"
                        android:textColor="@color/text_primary_dark" />

                    <RadioButton
                        android:id="@+id/rbNormal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/verbosity_normal"
                        android:textColor="@color/text_primary_dark" />

                    <RadioButton
                        android:id="@+id/rbHigh"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/verbosity_high"
                        android:textColor="@color/text_primary_dark" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- نقشه و ناوبری -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_s"
            android:text="@string/navigation_settings"
            android:textColor="@color/brand_accent"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.IranAmap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_m">

                <LinearLayout
                    android:id="@+id/rowMapStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_s">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/map_style"
                        android:src="@drawable/ic_layers"
                        app:tint="@color/text_secondary_dark" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/map_style"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvMapStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowOffline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_s">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/offline_maps"
                        android:src="@drawable/ic_offline"
                        app:tint="@color/text_secondary_dark" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/offline_maps"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/offline_maps_desc"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/offline_maps"
                        android:src="@drawable/ic_chevron"
                        app:tint="@color/text_secondary_dark" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw3d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/default_3d"
                    android:textColor="@color/text_primary_dark" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swShowLights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/show_lights"
                    android:textColor="@color/text_primary_dark" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swShowCameras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camera_alerts"
                    android:textColor="@color/text_primary_dark" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swSpeedLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/speed_limit_alerts"
                    android:textColor="@color/text_primary_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- درباره -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.IranAmap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
