<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.IranAmap" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_accent</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="fontFamily">@font/vazirmatn_regular</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="materialButtonStyle">@style/Widget.IranAmap.Button</item>
        <item name="bottomSheetDialogTheme">@style/Theme.IranAmap.BottomSheet</item>
    </style>

    <style name="Theme.IranAmap.BottomSheet" parent="Theme.Material3.Dark.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.IranAmap.BottomSheet</item>
    </style>

    <style name="Widget.IranAmap.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_dark_card</item>
        <item name="shapeAppearance">@style/ShapeAppearance.IranAmap.Sheet</item>
    </style>

    <style name="ShapeAppearance.IranAmap.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.IranAmap.Button" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/vazirmatn_medium</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.IranAmap.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/vazirmatn_bold</item>
        <item name="android:textColor">@color/text_primary_dark</item>
    </style>

    <style name="TextAppearance.IranAmap.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/vazirmatn_regular</item>
        <item name="android:textColor">@color/text_secondary_dark</item>
    </style>

    <style name="Widget.IranAmap.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_dark_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">6dp</item>
    </style>
</resources>
